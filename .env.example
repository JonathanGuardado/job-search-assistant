# Copy to .env.local and fill in. Parsed once in src/lib/env.ts — never read
# process.env anywhere else.

# Runtime connection: the non-owner app role. RLS applies to it, so every
# per-user query must run inside withTenant(). See docs/decisions/0004.
DATABASE_URL=postgres://job_seeker_app:job_seeker_app@localhost:5432/job_seeker
# Owner/superuser connection: migrations and `pnpm db:bootstrap` only.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/job_seeker
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379

# Two models, by role. Code says which role each task uses; these say which provider and
# model fill each role (docs/decisions/0015). Providers: gemini | deepseek. A role left
# unset stops only its own tasks. Check both with `pnpm ai:smoke`.
#
# Primary: eligibility and resume reading. Eligibility decides which jobs you see: after
# changing this model, run `pnpm eval:eligibility` before trusting its verdicts.
AI_PRIMARY_PROVIDER=gemini
AI_PRIMARY_MODEL=gemini-3.5-flash-lite
AI_PRIMARY_API_KEY=
# Secondary: matching and question drafting. After changing it, run `pnpm eval:matching`.
AI_SECONDARY_PROVIDER=deepseek
AI_SECONDARY_MODEL=deepseek-flash
AI_SECONDARY_API_KEY=

# Optional USD / million token rates, keyed by provider/model; see docs/ai-providers.md.
AI_MODEL_PRICING={}

# Uploaded resume files. Local disk, single host only (docs/decisions/0006).
STORAGE_DIR=.data/storage
