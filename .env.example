# Copy to .env.local and fill in. Parsed once in src/lib/env.ts — never read
# process.env anywhere else.

# Runtime connection: the non-owner app role. RLS applies to it, so every
# per-user query must run inside withTenant(). See docs/decisions/0004.
DATABASE_URL=postgres://job_seeker_app:job_seeker_app@localhost:5432/job_seeker
# Owner/superuser connection: migrations and `pnpm db:bootstrap` only.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/job_seeker
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379

AI_PROVIDER=deepseek
AI_API_KEY=

# Model per task tier. Changing these is a logged configuration change —
# see docs/architecture.md, LLM boundary.
MODEL_EXTRACTION=deepseek-flash
MODEL_REASONING=deepseek-v4-pro
# For Gemini: AI_PROVIDER=gemini, set AI_API_KEY to its key, and set both models to
# gemini-3.5-flash-lite (or another text model with configured pricing).
# Optional USD / million token rates, keyed by provider/model; see docs/ai-providers.md.
AI_MODEL_PRICING={}

# Object storage for resumes (milestone 1.3)
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
